{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--experimental-https",
        "--experimental-https-key",
        "certificates/lan-key.pem",
        "--experimental-https-cert",
        "certificates/lan.pem"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
